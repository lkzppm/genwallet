// Builds the Rust engine (engine/) to WebAssembly and embeds it in
// src/lib/ga/engine-wasm.ts, so the site, the nightly job and the tuner load
// it without a Rust toolchain or a fetch. Run after any change to engine/src.
//   pnpm engine:build

import { execFileSync } from "node:child_process";
import { createHash } from "node:crypto";
import { readFileSync, writeFileSync } from "node:fs";
import { homedir } from "node:os";
import { join } from "node:path";

const env = { ...process.env, PATH: `${join(homedir(), ".cargo", "bin")}:${process.env.PATH}` };
execFileSync("cargo", ["build", "--release", "--target", "wasm32-unknown-unknown"], { cwd: "engine", env, stdio: "inherit" });
const wasm = readFileSync("engine/target/wasm32-unknown-unknown/release/genwallet_engine.wasm");
const sha = createHash("sha256").update(wasm).digest("hex");
writeFileSync(
  "src/lib/ga/engine-wasm.ts",
  `// Generated by \`pnpm engine:build\` from engine/src; do not edit.\n` +
    `// ${wasm.length} bytes, sha256 ${sha}\n` +
    `export const ENGINE_WASM =\n  "${wasm.toString("base64")}";\n`,
);
console.log(`engine: ${wasm.length} bytes, sha256 ${sha.slice(0, 12)}`);
